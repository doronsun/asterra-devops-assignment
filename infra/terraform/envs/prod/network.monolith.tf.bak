# VPC בסיסי לפרויקט
resource "aws_vpc" "main" {
  cidr_block           = "10.0.0.0/16"
  enable_dns_hostnames = true
  enable_dns_support   = true

  tags = {
    Name = "${var.name_prefix}-vpc"
  }
}
# --- Internet Gateway (יציאה לאינטרנט לסאבנטים ציבוריים) ---
resource "aws_internet_gateway" "igw" {
  vpc_id = aws_vpc.main.id
  tags   = { Name = "${var.name_prefix}-igw" }
}

# --- Public Subnets בשני AZs ---
# eu-central-1a
resource "aws_subnet" "public_a" {
  vpc_id                  = aws_vpc.main.id
  cidr_block              = "10.0.0.0/20"
  availability_zone       = "${var.region}a"
  map_public_ip_on_launch = true # חשוב כדי ש-EC2 יקבל כתובת ציבורית אוטומטית
  tags                    = { Name = "${var.name_prefix}-public-a" }
}

# eu-central-1b
resource "aws_subnet" "public_b" {
  vpc_id                  = aws_vpc.main.id
  cidr_block              = "10.0.16.0/20"
  availability_zone       = "${var.region}b"
  map_public_ip_on_launch = true
  tags                    = { Name = "${var.name_prefix}-public-b" }
}

# --- Route Table ציבורית ---
resource "aws_route_table" "public" {
  vpc_id = aws_vpc.main.id
  tags   = { Name = "${var.name_prefix}-rt-public" }
}

# מסלול ברירת מחדל לאינטרנט דרך ה-IGW
resource "aws_route" "public_default" {
  route_table_id         = aws_route_table.public.id
  destination_cidr_block = "0.0.0.0/0"
  gateway_id             = aws_internet_gateway.igw.id
}

# --- חיבור הסאבנטים הציבוריים לטבלת הניתוב ---
resource "aws_route_table_association" "public_a_assoc" {
  subnet_id      = aws_subnet.public_a.id
  route_table_id = aws_route_table.public.id
}

resource "aws_route_table_association" "public_b_assoc" {
  subnet_id      = aws_subnet.public_b.id
  route_table_id = aws_route_table.public.id
}
resource "aws_security_group" "app_public_sg" {
  name        = "${var.name_prefix}-app-public-sg"
  description = "Allow HTTP from the Internet; all egress"
  vpc_id      = aws_vpc.main.id

  # כניסות מותרות: HTTP (80) מכל מקום (לדמו; בהמשך אפשר לצמצם)
  ingress {
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  # יציאה פתוחה (ברירת מחדל טובה לרוב שרתי ווב)
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = { Name = "${var.name_prefix}-app-public-sg" }
}

output "app_public_sg_id" {
  value = aws_security_group.app_public_sg.id
}
# --- Private Subnets בשני AZs (ל-RDS/שירותים פנימיים) ---
resource "aws_subnet" "private_a" {
  vpc_id            = aws_vpc.main.id
  cidr_block        = "10.0.128.0/20"
  availability_zone = "${var.region}a"
  tags              = { Name = "${var.name_prefix}-private-a" }
}

resource "aws_subnet" "private_b" {
  vpc_id            = aws_vpc.main.id
  cidr_block        = "10.0.144.0/20"
  availability_zone = "${var.region}b"
  tags              = { Name = "${var.name_prefix}-private-b" }
}

# --- SG ל-RDS: פתוח רק מ-SG האפליקטיבי (לא מהאינטרנט) ---
resource "aws_security_group" "rds_sg" {
  name        = "${var.name_prefix}-rds-sg"
  description = "Allow Postgres from app SG only"
  vpc_id      = aws_vpc.main.id

  ingress {
    description     = "Postgres from app_public_sg"
    from_port       = 5432
    to_port         = 5432
    protocol        = "tcp"
    security_groups = [aws_security_group.app_public_sg.id]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = { Name = "${var.name_prefix}-rds-sg" }
}

# --- Outputs נוחים לשימוש המשך ---
output "private_subnet_ids" {
  value = [aws_subnet.private_a.id, aws_subnet.private_b.id]
}

output "rds_sg_id" {
  value = aws_security_group.rds_sg.id
}
# -------- S3: ingest (פרטי) --------
resource "aws_s3_bucket" "ingest" {
  bucket        = "${var.name_prefix}-ingest"
  force_destroy = true # מאפשר מחיקה גם אם יש אובייקטים (ללמידה נוח)
  tags          = { Name = "${var.name_prefix}-ingest" }
}

resource "aws_s3_bucket_public_access_block" "ingest_block" {
  bucket                  = aws_s3_bucket.ingest.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

# -------- S3: public (למסמכים/half-pager) --------
resource "aws_s3_bucket" "public" {
  bucket        = "${var.name_prefix}-public"
  force_destroy = true
  tags          = { Name = "${var.name_prefix}-public" }
}

# אתר סטטי בסיסי (לא חובה, אבל נוח לשרת index.html)
resource "aws_s3_bucket_website_configuration" "public_site" {
  bucket = aws_s3_bucket.public.id
  index_document { suffix = "index.html" }
}

# מאפשר קריאה פומבית לאובייקטים בלבד
resource "aws_s3_bucket_policy" "public_read" {
  bucket = aws_s3_bucket.public.id
  policy = jsonencode({
    Version = "2012-10-17",
    Statement = [{
      Effect    = "Allow",
      Principal = "*",
      Action    = ["s3:GetObject"],
      Resource  = ["${aws_s3_bucket.public.arn}/*"]
    }]
  })
}
# לא לפחד משם המשאב - זה רק לזהות בתוך Terraform
resource "aws_s3_bucket_public_access_block" "public_allow" {
  bucket                  = aws_s3_bucket.public.id
  block_public_acls       = false
  ignore_public_acls      = false
  block_public_policy     = false
  restrict_public_buckets = false
}
resource "aws_s3_account_public_access_block" "account_relax" {
  # עדיין חוסמים/מתעלמים מ-ACLs, אבל
  # מתירים "Bucket Policy ציבורי" ודליים ציבוריים
  block_public_acls       = true
  ignore_public_acls      = true
  block_public_policy     = false
  restrict_public_buckets = false
}



# Outputs לנוחות
output "s3_ingest_bucket" { value = aws_s3_bucket.ingest.bucket }
output "s3_public_bucket" { value = aws_s3_bucket.public.bucket }
